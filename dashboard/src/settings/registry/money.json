{
  "schemaVersion": 2,
  "id": "money",
  "title": "Money and limits",
  "description": "What Conker may spend and how close you are to plan limits.",
  "icon": "wallet",
  "category": "brain",
  "order": 360,
  "sections": [
    {
      "id": "spending",
      "title": "Spending",
      "settings": [
        {
          "id": "money.paid",
          "title": "Paid models",
          "description": "Lets Conker use models that cost money per use.",
          "type": "toggle",
          "default": false,
          "tier": "basic",
          "scope": "global",
          "effect": "stored"
        },
        {
          "id": "money.currency",
          "title": "Currency",
          "description": "The currency for budgets and reports.",
          "type": "select",
          "default": "usd",
          "tier": "basic",
          "scope": "global",
          "effect": "stored",
          "options": [
            {
              "value": "usd",
              "label": "US dollar"
            },
            {
              "value": "eur",
              "label": "Euro"
            },
            {
              "value": "ils",
              "label": "Israeli shekel"
            }
          ]
        },
        {
          "id": "money.monthly",
          "title": "Monthly budget",
          "description": "The most Conker spends in a month; 0 means nothing paid.",
          "type": "number",
          "default": 0,
          "tier": "basic",
          "scope": "global",
          "effect": "stored",
          "min": 0,
          "max": 10000,
          "step": 1,
          "unit": "$"
        },
        {
          "id": "money.confirm_above",
          "title": "Ask before spending more than",
          "description": "Any single request above this asks you first.",
          "type": "number",
          "default": 1,
          "tier": "basic",
          "scope": "global",
          "effect": "stored",
          "min": 0,
          "max": 1000,
          "step": 1,
          "unit": "$"
        },
        {
          "id": "money.per_chat",
          "title": "Budget per chat",
          "description": "The most one chat may spend; 0 means no separate limit.",
          "type": "number",
          "default": 0,
          "tier": "advanced",
          "scope": "global",
          "effect": "stored",
          "min": 0,
          "max": 1000,
          "step": 1,
          "unit": "$"
        },
        {
          "id": "money.per_job",
          "title": "Budget per cron job",
          "description": "The most one cron job may spend in a month; 0 means no separate limit.",
          "type": "number",
          "default": 0,
          "tier": "advanced",
          "scope": "global",
          "effect": "stored",
          "min": 0,
          "max": 1000,
          "step": 1,
          "unit": "$"
        },
        {
          "id": "money.near_limit",
          "title": "Near a limit",
          "description": "What happens when a budget is almost used up.",
          "type": "select",
          "default": "ask",
          "tier": "basic",
          "scope": "global",
          "effect": "stored",
          "options": [
            {
              "value": "ask",
              "label": "Ask you"
            },
            {
              "value": "local",
              "label": "Switch to local models"
            },
            {
              "value": "cheaper",
              "label": "Switch to cheaper backups"
            },
            {
              "value": "stop",
              "label": "Stop"
            }
          ]
        },
        {
          "id": "money.show_cost",
          "title": "Show the cost before sending",
          "description": "Shows what a request will likely cost before it is sent.",
          "type": "toggle",
          "default": true,
          "tier": "basic",
          "scope": "global",
          "effect": "stored"
        },
        {
          "id": "money.report",
          "title": "Monthly report",
          "description": "A summary of what Conker spent, in the Inbox each month.",
          "type": "toggle",
          "default": true,
          "tier": "basic",
          "scope": "global",
          "effect": "stored"
        }
      ]
    },
    {
      "id": "plans",
      "title": "Plan usage",
      "settings": [
        {
          "id": "plans.alerts",
          "title": "Plan usage alerts",
          "description": "Tells you when a Claude or ChatGPT plan window is nearly used up.",
          "type": "toggle",
          "default": true,
          "tier": "basic",
          "scope": "global",
          "effect": "live",
          "home": {
            "service": "pi",
            "path": "/owner/preferences",
            "key": "preferences",
            "verify": true,
            "field": "planAlerts.enabled"
          }
        },
        {
          "id": "plans.alert_percent",
          "title": "Alert at",
          "description": "How full a plan window is before you are told.",
          "type": "number",
          "default": 80,
          "tier": "basic",
          "scope": "global",
          "effect": "live",
          "min": 50,
          "max": 100,
          "step": 5,
          "unit": "%",
          "dependsOn": {
            "id": "plans.alerts",
            "value": true
          },
          "home": {
            "service": "pi",
            "path": "/owner/preferences",
            "key": "preferences",
            "verify": true,
            "field": "planAlerts.percent"
          }
        },
        {
          "id": "money.plan_windows",
          "title": "Windows to watch",
          "description": "Which plan windows count for alerts.",
          "type": "list",
          "default": [
            "five_hour",
            "weekly"
          ],
          "tier": "advanced",
          "scope": "global",
          "effect": "stored",
          "options": [
            {
              "value": "five_hour",
              "label": "5-hour"
            },
            {
              "value": "weekly",
              "label": "Weekly"
            }
          ]
        }
      ]
    }
  ]
}
