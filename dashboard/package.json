    "msw": "2.15.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
