#!/bin/sh
# Thin installed entrypoint. Command behavior lives in the exported companion source.
set -eu

deployment=${CONKER_DEPLOY_DIR:-"$HOME/conker-deploy"}
cli=${CONKER_COMPANION_CLI:-"$deployment/sources/companion/conker"}

if [ ! -f "$cli" ]; then
    printf 'Conker command implementation not found: %s\n' "$cli" >&2
    printf 'Restore the reviewed companion source export for this deployment.\n' >&2
    exit 1
fi
if ! command -v bash >/dev/null 2>&1; then
    printf 'Bash is required to run the Conker command contract.\n' >&2
    exit 1
fi

export CONKER_LAYOUT=ubuntu CONKER_DEPLOY_DIR="$deployment"
exec bash "$cli" "$@"
