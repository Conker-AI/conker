#!/usr/bin/env bash
#
# conker — everything you do after installing.
#
# Deliberately small. Each command is one job, named as the thing you want
# rather than the mechanism underneath: `conker status` and not
# `docker compose ps`, because the answer people want is "is it working",
# not "which containers exist".

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT/.env"

# Recovery must work after losing .env. Never source configuration from a
# backup: it is data to inspect, not shell code to execute.
case "${1:-status}" in
    backup|restore|verify-backup|recovery-status)
        command -v python3 >/dev/null 2>&1 || {
            printf 'Python 3.11+ is required for recovery. Install python3, then retry.\n' >&2
            exit 1
        }
        exec python3 "$ROOT/scripts/recovery.py" --root "$ROOT" "$@"
        ;;
esac

case "${1:-status}" in
    start|restart|update|model|auth)
        if [ -f "$ROOT/.conker-recovery.json" ] || [ -f "$PWD/.conker-recovery.json" ]; then
            printf 'Recovery is held. Run conker recovery-status DIRECTORY and resolve its blockers before deployment.\n' >&2
            exit 1
        fi
        if [ -f "$ROOT/.conker-backup.lock" ]; then
            printf 'Backup is running or was interrupted. Inspect its partial snapshot and source-state.json before restarting writers.\n' >&2
            exit 1
        fi
        ;;
esac

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
    YELLOW=$'\033[33m'; BLUE=$'\033[34m'; OFF=$'\033[0m'
else
    BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; BLUE=''; OFF=''
fi

say()  { printf '%s\n' "$*"; }
good() { printf '  %s✓%s %s\n' "$GREEN" "$OFF" "$*"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$OFF" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$RED" "$OFF" "$*"; }
info() { printf '  %s%s%s\n' "$DIM" "$*" "$OFF"; }

[ -f "$ENV_FILE" ] || {
    printf '%sConker is not installed here.%s\n\n  Run: ./install.sh\n\n' "$BOLD" "$OFF" >&2
    exit 1
}

set -a
# shellcheck disable=SC1090  # the path is known only at runtime
. "$ENV_FILE"
set +a

compose() {
    docker compose --env-file "$ROOT/versions.env" --env-file "$ENV_FILE" \
        -f "$ROOT/docker-compose.yml" "$@"
}

# The top-level status, and never a nested one.
#
# `sed 's/.*"status".../'` looks right and is wrong: `.*` is greedy, so it walks
# to the LAST "status" in the body - whichever check happens to appear last. A
# Pi reporting `degraded` because its model was unreachable displayed as `ok`,
# because `action_boundary` came last and said so.
#
# The health contract puts the service-level status before `checks`, so the
# first match is both correct and the honest reading. Getting this wrong in the
# status command is the worst possible place for it: the owner is told
# everything is fine at exactly the moment they need to know it is not.
top_level_status() {
    grep -o '"status"[[:space:]]*:[[:space:]]*"[a-z_]*"' \
        | head -1 \
        | sed 's/.*"\([a-z_]*\)"$/\1/'
}

# --- status -----------------------------------------------------------------
# Asks each service what it thinks of itself, rather than reporting that a
# container exists. A running container that cannot reach its database is not
# a working service, and saying "up" there would be the useful lie.
cmd_status() {
    local names=(Conker Tools Memory System Embeddings)
    local ports=("${CONKER_PORT:-8050}" 8010 8020 8040 8030)
    local worst=ok i

    say ""
    say "${BOLD}Conker${OFF}"
    say ""
    for i in "${!names[@]}"; do
        local body status
        if [ "$i" -eq 0 ]; then
            body=$(compose exec -T gateway python -m gateway health 2>/dev/null || true)
        else
            body=$(curl -fsS -m 3 "http://127.0.0.1:${ports[$i]}/health" 2>/dev/null || true)
        fi
        if [ -z "$body" ]; then
            bad "$(printf '%-12s' "${names[$i]}") not answering on ${ports[$i]}"
            worst=down
            continue
        fi
        status=$(printf '%s' "$body" | top_level_status)
        case "$status" in
            ok) good "$(printf '%-12s' "${names[$i]}") ok" ;;
            degraded)
                local why
                why=$(printf '%s' "$body" | sed -n 's/.*"degraded"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')
                warn "$(printf '%-12s' "${names[$i]}") degraded — ${why//\"/}"
                [ "$worst" = ok ] && worst=degraded ;;
            *) warn "$(printf '%-12s' "${names[$i]}") $status" ; [ "$worst" = ok ] && worst=degraded ;;
        esac
    done
    say ""
    case "$worst" in
        ok)       say "  ${GREEN}Everything is working.${OFF}" ;;
        degraded) say "  ${YELLOW}Running, with something degraded.${OFF} Details above." ;;
        down)     say "  ${RED}Something is not running.${OFF}  Try: ./conker restart" ;;
    esac
    say ""
    say "  ${BOLD}Open:${OFF} ${BLUE}${GATEWAY_ORIGIN:-https://localhost:8050}${OFF}"
    say "  ${DIM}Backups: ${CONKER_BACKUP_DIR}${OFF}"
    say ""
}

# --- tailscale --------------------------------------------------------------
# Offered, never assumed. Conker binds to localhost and there is no
# public-internet path at all; this is how a second device reaches it without
# creating one.
cmd_tailscale() {
    say ""
    say "${BOLD}Reaching Conker from your other devices${OFF}"
    say ""
    info "Conker listens on this machine only. That is deliberate — there is no"
    info "public-internet path to it, and opening one is not something this"
    info "installer will do for you."
    say ""
    info "Tailscale builds a private network between your own devices instead."
    info "Your phone and laptop reach Conker; nobody else can, because there is"
    info "nothing exposed to reach."
    say ""
    if command -v tailscale >/dev/null 2>&1; then
        good "Tailscale is installed"
        if tailscale status >/dev/null 2>&1; then
            good "Connected"
            say ""
            say "  Remote browser access also needs HTTPS forwarding to the local gateway."
            say "  Configure its exact HTTPS address as GATEWAY_ORIGIN before signing in."
            say ""
            info "See docs/reference/browser-auth.md. Joining Tailscale alone does not expose the localhost listener."
        else
            say "  Not connected yet. Run:"
            say "     ${BOLD}sudo tailscale up${OFF}"
        fi
    else
        say "  Tailscale is not installed. To add it:"
        say "     ${BOLD}curl -fsSL https://tailscale.com/install.sh | sh${OFF}"
        say "     ${BOLD}sudo tailscale up${OFF}"
        say ""
        info "Then configure HTTPS forwarding as described in docs/reference/browser-auth.md."
    fi
    say ""
    warn "One thing Conker will not do: bind to 0.0.0.0."
    info "That would put your companion on the open internet. If you truly want"
    info "that, it is your own reverse proxy and your own decision."
    say ""
}

# --- the rest ---------------------------------------------------------------
cmd_model()   { compose exec -T ollama ollama pull "${1:?which model? e.g. ./conker model qwen3:4b}"; }
cmd_logs()    { compose logs --tail "${2:-100}" ${1:+"$1"}; }
cmd_start()   { compose up -d && cmd_status; }
cmd_stop()    { compose stop && say "" && say "  Stopped. Nothing was deleted." && say ""; }
cmd_restart() { compose restart && cmd_status; }

# The admin key is not printed casually. It is the key to everything here.
cmd_key() {
    say ""
    warn "This is the key to everything Conker holds. Do not paste it anywhere."
    say ""
    say "  $CONKER_ADMIN_KEY"
    say ""
}

cmd_update() {
    say ""
    say "${BOLD}Updating${OFF}"
    info "Versions are pinned in versions.env. This pulls exactly what is written"
    info "there — edit that file, or pull the repo, to move to a newer release."
    say ""
    git -C "$ROOT" pull --ff-only 2>/dev/null && good "Repository updated" || info "Not a git checkout; using versions.env as it is"
    compose pull && compose up -d
    cmd_status
}

usage() {
    cat <<USAGE

${BOLD}conker${OFF} — your companion, on this machine

  ${BOLD}status${OFF}      Is it working, and what is not
  ${BOLD}tailscale${OFF}   Reach Conker from your phone or laptop
  ${BOLD}backup${OFF} [--destination DIR]  Create a verified snapshot (stops writers during capture)
  ${BOLD}verify-backup${OFF} SNAPSHOT     Check snapshot files and hashes
  ${BOLD}restore${OFF} SNAPSHOT --into DIR  Restore into fresh, isolated volumes; remains held
  ${BOLD}recovery-status${OFF} DIR        Read the recovery hold and unresolved work
  ${BOLD}logs${OFF} [svc]  What a service has been saying
  ${BOLD}model${OFF} NAME  Fetch another local model
  ${BOLD}start${OFF} / ${BOLD}stop${OFF} / ${BOLD}restart${OFF}
  ${BOLD}update${OFF}      Pull the pinned versions and restart
  ${BOLD}key${OFF}         Show the admin key
  ${BOLD}auth${OFF} setup|reset-password|revoke-all|certificate|renew-certificate
              Browser access and TLS, managed from this host

USAGE
}

case "${1:-status}" in
    auth)
        case "${2:-}" in
            setup|reset-password) compose run --rm --no-deps gateway python -m gateway "$2" ;;
            revoke-all|certificate|renew-certificate) compose run --rm --no-deps -T gateway python -m gateway "$2" ;;
            *) printf 'Use conker auth setup, reset-password, revoke-all, certificate or renew-certificate.\n' >&2; exit 1 ;;
        esac ;;
    status)    cmd_status ;;
    tailscale) cmd_tailscale ;;
    logs)      shift; cmd_logs "$@" ;;
    model)     shift; cmd_model "$@" ;;
    start)     cmd_start ;;
    stop)      cmd_stop ;;
    restart)   cmd_restart ;;
    update)    cmd_update ;;
    key)       cmd_key ;;
    -h|--help|help) usage ;;
    *) printf '\n  No command called %s.\n' "$1"; usage; exit 1 ;;
esac
