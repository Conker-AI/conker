command="${1:-status}"

case "$command" in
    help|-h|--help) usage; exit 0 ;;
    providers) shift; cmd_providers "$@"; exit $? ;;
    speech) shift; cmd_speech "$@"; exit $? ;;
    backup|restore|verify-backup|recovery-status)
        command -v python3 >/dev/null 2>&1 || {
            printf 'Python 3.11+ is required for recovery. Install python3, then retry.\n' >&2
            exit 1
        }
        exec python3 "$SOURCE_ROOT/scripts/recovery.py" --root "$ROOT" "$@"
        ;;
esac

case "$command" in
    start|restart|update|model|auth) recovery_guard ;;
esac

load_layout

case "$command" in
    auth)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        case "${2:-}" in
            setup|reset-password) compose run --rm --no-deps gateway python -m gateway "$2" ;;
            revoke-all|certificate|renew-certificate|health)
                compose run --rm --no-deps -T gateway python -m gateway "$2"
                ;;
            *)
                printf 'Use conker auth setup, reset-password, revoke-all, certificate, renew-certificate or health.\n' >&2
                exit 2
                ;;
        esac
        ;;
    status)    [ "$#" -le 1 ] || { usage >&2; exit 2; }; cmd_status ;;
    doctor)    [ "$#" -eq 1 ] || { usage >&2; exit 2; }; cmd_doctor ;;
    inspect)   [ "$#" -ge 2 ] && [ "$#" -le 5 ] || { usage >&2; exit 2; }; shift; cmd_inspect "$@" ;;
    apply)     [ "$#" -eq 3 ] || { usage >&2; exit 2; }; shift; cmd_apply "$1" "$2" ;;
    tailscale) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; cmd_tailscale ;;
    logs)      [ "$#" -le 3 ] || { usage >&2; exit 2; }; shift; cmd_logs "$@" ;;
    model)     [ "$#" -eq 2 ] || { usage >&2; exit 2; }; shift; cmd_model "$@" ;;
    start)     [ "$#" -eq 1 ] || { usage >&2; exit 2; }; cmd_start ;;
    stop)      [ "$#" -eq 1 ] || { usage >&2; exit 2; }; cmd_stop ;;
    restart)   [ "$#" -eq 1 ] || { usage >&2; exit 2; }; cmd_restart ;;
    update)    [ "$#" -eq 1 ] || { usage >&2; exit 2; }; cmd_update ;;
    setup)     shift; cmd_setup "$@" ;;
    key)       [ "$#" -eq 1 ] || { usage >&2; exit 2; }; cmd_key ;;
    *) printf '\n  No command called %s.\n' "$command" >&2; usage >&2; exit 2 ;;
esac
