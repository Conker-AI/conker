speech_runtime_state() {
    local expected=$1 result
    for _ in $(seq 1 30); do
        result=$(compose exec -T pi python -c '
import json, sys, urllib.request
expected = sys.argv[1]
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
try:
    with opener.open("http://127.0.0.1:8050/health", timeout=3) as response:
        body = response.read(262145)
    if len(body) > 262144:
        raise ValueError()
    actual = json.loads(body)["checks"]["speech"]["input"]
    print("confirmed" if actual == expected else "waiting")
except Exception:
    print("unavailable")
' "$expected" 2>/dev/null || true)
        [ "$result" = confirmed ] && return 0
        sleep 1
    done
    return 1
}

speech_status_human() {
    speech_call status | python3 -c '
import json, sys
value = json.load(sys.stdin)
print("\nSpeech\n")
print(f"  Input:       {value[\"speechInput\"]}")
print(f"  Output:      {value[\"speechOutput\"]}")
print(f"  Credential:  {\"configured\" if value[\"credentialConfigured\"] else \"not configured\"}")
print(f"  Character:   {value[\"characterVoice\"]}")
print("\n  Secret values are not included.\n")
'
}

speech_apply() {
    local action=$1 expected=$2 backup result
    shift 2
    recovery_guard
    backup=$(mktemp -d)
    cp -p "$(speech_env_file)" "$backup/env"
    if [ -f "$(speech_key_file)" ]; then
        cp -p "$(speech_key_file)" "$backup/key"
    else
        : > "$backup/key"
    fi
    if ! result=$(speech_call "$action" "$@"); then
        rm -rf "$backup"
        return 1
    fi
    if compose up -d --no-deps --force-recreate pi \
            && speech_runtime_state "$expected"; then
        rm -rf "$backup"
        printf '%s\n' "$result"
        good "Speech configuration is active"
        return 0
    fi
    warn "Pi did not confirm the speech configuration; restoring the previous files"
    cp -p "$backup/env" "$(speech_env_file)"
    mkdir -p "$(dirname "$(speech_key_file)")"
    cp -p "$backup/key" "$(speech_key_file)"
    rm -rf "$backup"
    compose up -d --no-deps --force-recreate pi >/dev/null 2>&1 || true
    printf 'Speech activation failed and the previous host configuration was restored.\n' >&2
    return 1
}

cmd_speech() {
    command -v python3 >/dev/null 2>&1 || {
        printf 'Python 3.11+ is required for speech configuration.\n' >&2
        exit 1
    }
    require_installation
    local action=${1:-status}
    shift || true
    case "$action" in
        status)
            if [ "${1:-}" = --json ] && [ "$#" -eq 1 ]; then
                speech_call status
            elif [ "$#" -eq 0 ]; then
                speech_status_human
            else
                printf 'Use conker speech status [--json].\n' >&2; exit 2
            fi
            ;;
        configure)
            if [ "$#" -eq 0 ] && [ -t 0 ]; then
                local speech_url stt_model tts_model voice speech_key
                printf 'Speech API base URL: '
                read -r speech_url
                printf 'Speech-to-text model: '
                read -r stt_model
                printf 'Text-to-speech model (optional): '
                read -r tts_model
                voice=''
                if [ -n "$tts_model" ]; then
                    printf 'Default voice: '
                    read -r voice
                fi
                printf 'API key (optional, input hidden): '
                read -r -s speech_key || speech_key=''
                printf '\n'
                if [ -n "$speech_key" ]; then
                    printf '%s' "$speech_key" | speech_apply configure configured \
                        --url "$speech_url" --stt-model "$stt_model" \
                        --tts-model "$tts_model" --voice "$voice" --key-stdin
                    unset speech_key
                else
                    speech_apply configure configured --url "$speech_url" \
                        --stt-model "$stt_model" --tts-model "$tts_model" --voice "$voice"
                fi
            elif [ "$#" -gt 0 ]; then
                speech_apply configure configured "$@"
            else
                printf 'Use an interactive terminal, or pass --url URL --stt-model MODEL [--tts-model MODEL --voice VOICE] [--key-stdin].\n' >&2
                exit 2
            fi
            ;;
        disable)
            [ "$#" -eq 0 ] || { printf 'Use conker speech disable.\n' >&2; exit 2; }
            speech_apply disable unconfigured
            ;;
        *)
            printf 'Use conker speech status, configure, or disable.\n' >&2
            exit 2
            ;;
    esac
}

