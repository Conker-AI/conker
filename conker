#!/usr/bin/env bash
#
# conker - the authoritative host command contract for every deployment layout.

set -euo pipefail

SOURCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAYOUT="${CONKER_LAYOUT:-repository}"

case "$LAYOUT" in
    repository) ROOT="$SOURCE_ROOT"; ENV_FILE="$ROOT/.env" ;;
    ubuntu) ROOT="${CONKER_DEPLOY_DIR:-$HOME/conker-deploy}"; ENV_FILE="" ;;
    *) printf 'Unknown Conker deployment layout: %s\n' "$LAYOUT" >&2; exit 2 ;;
esac

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
    YELLOW=$'\033[33m'; BLUE=$'\033[34m'; OFF=$'\033[0m'
else
    BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; BLUE=''; OFF=''
fi

say()  { printf '%s\n' "$*"; }
good() { printf '  %s✓%s %s\n' "$GREEN" "$OFF" "$*"; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$OFF" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$RED" "$OFF" "$*"; }
info() { printf '  %s%s%s\n' "$DIM" "$*" "$OFF"; }

layout_label() {
    case "$LAYOUT" in
        repository) printf '%s' 'repository installation' ;;
        ubuntu) printf '%s' 'source-built Ubuntu installation' ;;
    esac
}

unavailable() {
    local command=$1 reason=$2
    printf 'conker %s is unavailable for this %s.\n%s\n' \
        "$command" "$(layout_label)" "$reason" >&2
    exit 3
}

require_installation() {
    case "$LAYOUT" in
        repository)
            [ -f "$ENV_FILE" ] || {
                printf '%sConker is not installed here.%s\n\n  Run: ./install.sh\n\n' "$BOLD" "$OFF" >&2
                exit 1
            }
            ;;
        ubuntu)
            [ -f "$ROOT/compose.json" ] || {
                printf 'Conker deployment not found: %s\n' "$ROOT" >&2
                exit 1
            }
            ;;
    esac
}

load_layout() {
    require_installation
    if [ "$LAYOUT" = repository ]; then
        # The Compose environment is data, never shell code. Read only the few
        # host-display values this command needs; Compose parses the full file itself.
        CONKER_PORT=$(sed -n 's/^CONKER_PORT=//p' "$ENV_FILE" | head -1)
        CONKER_BACKUP_DIR=$(sed -n 's/^CONKER_BACKUP_DIR=//p' "$ENV_FILE" | head -1)
        CONKER_ADMIN_KEY=$(sed -n 's/^CONKER_ADMIN_KEY=//p' "$ENV_FILE" | head -1)
        GATEWAY_ORIGIN=$(sed -n 's/^GATEWAY_ORIGIN=//p' "$ENV_FILE" | head -1)
        GATEWAY_DISPLAY_ORIGIN="${GATEWAY_ORIGIN:-https://localhost:${CONKER_PORT:-8050}}"
    else
        GATEWAY_DISPLAY_ORIGIN=$(sed -n 's/^GATEWAY_ORIGIN=//p' "$ROOT/state/gateway.env" 2>/dev/null | head -1)
        GATEWAY_DISPLAY_ORIGIN="${GATEWAY_DISPLAY_ORIGIN:-https://localhost:18050}"
    fi
}

owner_terminal_active() {
    [ "$LAYOUT" = repository ] \
        && grep -qx 'OWNER_TERMINAL_STATE=active' "$ROOT/versions.env"
}

compose() {
    if [ "$LAYOUT" = repository ]; then
        local files=(-f "$ROOT/docker-compose.yml")
        if owner_terminal_active; then
            files+=(-f "$ROOT/docker-compose.terminal.yml")
        fi
        docker compose --env-file "$ROOT/versions.env" --env-file "$ENV_FILE" \
            "${files[@]}" "$@"
    else
        docker compose --project-directory "$ROOT" -f "$ROOT/compose.json" "$@"
    fi
}

recovery_guard() {
    if [ -f "$ROOT/.conker-recovery.json" ] || [ -f "$PWD/.conker-recovery.json" ]; then
        printf 'Recovery is held. Run conker recovery-status DIRECTORY and resolve its blockers before deployment.\n' >&2
        exit 1
    fi
    if [ -f "$ROOT/.conker-backup.lock" ]; then
        printf 'Backup is running or was interrupted. Inspect its partial snapshot and source-state.json before restarting writers.\n' >&2
        exit 1
    fi
}

top_level_status() {
    grep -o '"status"[[:space:]]*:[[:space:]]*"[a-z_]*"' \
        | head -1 \
        | sed 's/.*"\([a-z_]*\)"$/\1/'
}

health_body() {
    local service=$1 port=$2
    if [ "$service" = gateway ]; then
        compose exec -T gateway python -m gateway health 2>/dev/null || true
    elif [ "$LAYOUT" = repository ]; then
        curl -fsS -m 3 "http://127.0.0.1:${port}/health" 2>/dev/null || true
    else
        compose exec -T "$service" python -c \
            'import sys, urllib.request; sys.stdout.write(urllib.request.urlopen(sys.argv[1], timeout=3).read().decode())' \
            "http://127.0.0.1:${port}/health" 2>/dev/null || true
    fi
}

cmd_status() {
    local names=(Conker Tools Memory System Embeddings)
    local services=(gateway toolgate memorygate systemgate embeddings)
    local ports=(8050 8010 8020 8040 8030)
    local worst=ok i

    say ""
    say "${BOLD}Conker${OFF}"
    say ""
    for i in "${!names[@]}"; do
        local body status why
        body=$(health_body "${services[$i]}" "${ports[$i]}")
        if [ -z "$body" ]; then
            bad "$(printf '%-12s' "${names[$i]}") not answering"
            worst=down
            continue
        fi
        status=$(printf '%s' "$body" | top_level_status || true)
        case "$status" in
            ok) good "$(printf '%-12s' "${names[$i]}") ok" ;;
            degraded)
                why=$(printf '%s' "$body" | sed -n 's/.*"degraded"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p')
                warn "$(printf '%-12s' "${names[$i]}") degraded${why:+ - ${why//\"/}}"
                [ "$worst" = ok ] && worst=degraded
                ;;
            *)
                warn "$(printf '%-12s' "${names[$i]}") invalid health response"
                [ "$worst" = ok ] && worst=degraded
                ;;
        esac
    done
    say ""
    case "$worst" in
        ok) say "  ${GREEN}Everything is working.${OFF}" ;;
        degraded) say "  ${YELLOW}Running, with something degraded.${OFF} Details above." ;;
        down) say "  ${RED}Something is not running.${OFF} Try: conker restart" ;;
    esac
    say ""
    say "  ${BOLD}Open:${OFF} ${BLUE}${GATEWAY_DISPLAY_ORIGIN}${OFF}"
    if [ "$LAYOUT" = repository ]; then
        say "  ${DIM}Backups: ${CONKER_BACKUP_DIR}${OFF}"
    else
        say "  ${DIM}Layout: source-built Ubuntu installation${OFF}"
    fi
    say ""
}

cmd_tailscale() {
    say ""
    say "${BOLD}Reaching Conker from your other devices${OFF}"
    say ""
    info "Conker listens on this machine only. Tailscale can provide a private"
    info "path from your other devices without publishing Conker to the internet."
    say ""
    if command -v tailscale >/dev/null 2>&1; then
        good "Tailscale is installed"
        if tailscale status >/dev/null 2>&1; then
            good "Connected"
        else
            say "  Not connected yet. Run:"
            say "     ${BOLD}sudo tailscale up${OFF}"
        fi
    else
        say "  Tailscale is not installed. To add it:"
        say "     ${BOLD}curl -fsSL https://tailscale.com/install.sh | sh${OFF}"
        say "     ${BOLD}sudo tailscale up${OFF}"
    fi
    say ""
    info "Remote browser access also needs HTTPS forwarding and the exact external"
    info "address configured as GATEWAY_ORIGIN. See docs/reference/browser-auth.md."
    say ""
    warn "Conker will not bind itself to 0.0.0.0."
    say ""
}

cmd_model()   { compose exec -T ollama ollama pull "${1:?which model? e.g. conker model qwen3:4b}"; }
cmd_logs() {
    local args=(logs --tail "${2:-100}")
    [ -z "${1:-}" ] || args+=("$1")
    compose "${args[@]}"
}
cmd_start()   { compose up -d && cmd_status; }
cmd_stop()    { compose stop && say "" && say "  Stopped. Nothing was deleted." && say ""; }
cmd_restart() { compose restart && cmd_status; }
cmd_doctor()  { compose exec -T gateway python -m gateway doctor; }
cmd_inspect() {
    local resource=${1:-}
    if [ "$resource" = tool-access ]; then
        [ "$#" -eq 4 ] || {
            printf 'Use conker inspect tool-access DRAFT_ID VERSION DIGEST.\n' >&2
            exit 2
        }
        resource="$resource:$2:$3:$4"
    elif [ "$resource" = session-settings ] || [ "$resource" = approval ] || [ "$resource" = submission ] || [ "$resource" = file-listing ] || [ "$resource" = inventory ] || [ "$resource" = call ] || [ "$resource" = active-call ] || [ "$resource" = tool-draft ] || [ "$resource" = tool-validation ] || [ "$resource" = tool-publications ] || [ "$resource" = tool-runs ]; then
        [ "$#" -eq 2 ] || {
            printf 'Use conker inspect %s ID.\n' "$resource" >&2
            exit 2
        }
        resource="$resource:$2"
    elif [ "$#" -ne 1 ]; then
        printf 'Use conker inspect RESOURCE, or a supported validated resource identity.\n' >&2
        exit 2
    fi
    compose exec -T gateway python -m gateway inspect "$resource"
}
cmd_apply() {
    local resource=$1 file=$2
    case "$resource" in
        agents|approvals|artifacts|calls|character|files|inventory|jobs|memory|models|projects|proposals|sessions|tasks|teams|tools|turns) ;;
        *) printf 'conker apply supports: agents, approvals, artifacts, calls, character, files, inventory, jobs, memory, models, projects, proposals, sessions, tasks, teams, tools, turns.\n' >&2; exit 2 ;;
    esac
    [ -f "$file" ] || {
        printf 'Configuration file not found: %s\n' "$file" >&2
        exit 2
    }
    compose exec -T gateway python -m gateway apply "$resource" < "$file"
}

cmd_key() {
    [ "$LAYOUT" = repository ] || unavailable key \
        'This layout has separate scoped credentials; there is no single admin key to reveal.'
    say ""
    warn "This is the key to everything Conker holds. Do not paste it anywhere."
    say ""
    say "  $CONKER_ADMIN_KEY"
    say ""
}

cmd_update() {
    [ "$LAYOUT" = repository ] || unavailable update \
        'Source-built deployments require a reviewed source export, image rebuild, and rollback record.'
    say ""
    say "${BOLD}Updating${OFF}"
    info "The candidate is staged and verified before running services change."
    say ""
    command -v python3 >/dev/null 2>&1 || {
        printf 'Python 3.11+ is required for verified updates. Install python3, then retry.\n' >&2
        exit 1
    }
    python3 "$ROOT/scripts/update.py" --root "$ROOT"
}

setup_status() {
    compose exec -T gateway python -c '
import json, os, urllib.request

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, file_pointer, code, message, headers, new_url):
        return None

url = os.environ["GATEWAY_PI_URL"].rstrip("/") + "/setup/status"
request = urllib.request.Request(url, headers={
    "Accept": "application/json",
    "X-Pi-Owner-Key": os.environ["GATEWAY_PI_OWNER_KEY"],
})
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
try:
    with opener.open(request, timeout=10) as response:
        body = response.read(262145)
except Exception as error:
    raise SystemExit(f"setup status unavailable: {type(error).__name__}") from None
if len(body) > 262144:
    raise SystemExit("setup status exceeded 256 KiB")
try:
    value = json.loads(body)
except Exception:
    raise SystemExit("Pi returned invalid setup-status JSON") from None
if not isinstance(value, dict) or value.get("schemaVersion") != 1:
    raise SystemExit("Pi returned an unsupported setup-status contract")
print(json.dumps(value, indent=2, sort_keys=True))
'
}

record_setup_receipt() {
    local step=$1
    compose exec -T gateway python -m gateway record-setup-receipt "$step"
}

cmd_setup() {
    local action=${1:-}
    shift || true
    case "$action" in
        status)
            [ "$#" -eq 0 ] || { printf 'Use conker setup status.\n' >&2; exit 2; }
            setup_status
            ;;
        models)
            [ "$#" -eq 0 ] || { printf 'Use conker setup models.\n' >&2; exit 2; }
            compose exec -T gateway python -m gateway setup-model-options
            ;;
        rehearsal)
            [ "$#" -eq 0 ] || { printf 'Use conker setup rehearsal.\n' >&2; exit 2; }
            compose exec -T gateway python -m gateway setup-rehearsal status
            ;;
        protection)
            [ "$#" -eq 0 ] || { printf 'Use conker setup protection.\n' >&2; exit 2; }
            compose exec -T gateway python -m gateway setup-protection
            ;;
        configure)
            local step=${1:-}
            shift || true
            case "$step" in
                protection)
                    local destination='' retention=7
                    while [ "$#" -gt 0 ]; do
                        case "$1" in
                            --destination) [ "$#" -ge 2 ] || exit 2; destination=$2; shift 2 ;;
                            --retention) [ "$#" -ge 2 ] || exit 2; retention=$2; shift 2 ;;
                            *) printf 'Use conker setup configure protection --destination /mounted/path [--retention COPIES].\n' >&2; exit 2 ;;
                        esac
                    done
                    [ -n "$destination" ] || { printf 'A mounted off-machine --destination is required.\n' >&2; exit 2; }
                    [[ "$retention" =~ ^[0-9]+$ ]] && [ "$retention" -ge 2 ] && [ "$retention" -le 64 ] || {
                        printf 'Retention must be between 2 and 64 verified snapshots.\n' >&2
                        exit 2
                    }
                    DESTINATION="$destination" RETENTION="$retention" python3 -c '
import json, os
print(json.dumps({"destination": os.environ["DESTINATION"], "retentionCopies": int(os.environ["RETENTION"])}))
' | compose exec -T gateway python -m gateway set-setup-protection
                    ;;
                *)
                    printf 'Use conker setup configure protection --destination /mounted/path [--retention COPIES].\n' >&2
                    exit 2
                    ;;
            esac
            ;;
        verify-protection)
            command -v python3 >/dev/null 2>&1 || {
                printf 'Python 3.11+ is required for setup evidence. Install python3, then retry.\n' >&2
                exit 1
            }
            [ "$#" -eq 0 ] || { printf 'Protection uses the saved policy. Run conker setup configure protection first.\n' >&2; exit 2; }
            local protection_receipt protection_policy
            protection_receipt=$(mktemp "${TMPDIR:-/tmp}/conker-setup-protection.XXXXXX")
            protection_policy=$(mktemp "${TMPDIR:-/tmp}/conker-setup-policy.XXXXXX")
            trap 'rm -f "$protection_receipt" "$protection_policy"' RETURN
            compose exec -T gateway python -m gateway setup-protection > "$protection_policy"
            env -u GATEWAY_PI_OWNER_KEY python3 "$SOURCE_ROOT/scripts/setup.py" \
                protection --root "$ROOT" \
                --policy "$protection_policy" --output "$protection_receipt"
            record_setup_receipt protection < "$protection_receipt"
            rm -f "$protection_receipt" "$protection_policy"
            trap - RETURN
            ;;
        run)
            local step=${1:-}
            shift || true
            case "$step" in
                boundaries)
                    [ "$#" -eq 2 ] && [ "$1" = --confirm-digest ] || {
                        printf 'First run conker inspect boundaries, review the policy, then use conker setup run boundaries --confirm-digest SHA256.\n' >&2
                        exit 2
                    }
                    compose exec -T gateway python -m gateway review-boundaries "$2"
                    ;;
                memory|capabilities)
                    [ "$#" -eq 1 ] && { [ "$1" = --skip ] || [ "$1" = --include ]; } || {
                        printf 'Use conker setup run %s --skip|--include.\n' "$step" >&2
                        exit 2
                    }
                    local choice=${1#--}
                    compose exec -T gateway python -m gateway set-setup-choice "$step:$choice"
                    ;;
                companion)
                    [ "$#" -eq 1 ] && [ "$1" = --accept ] || {
                        printf 'Use conker setup run companion --accept.\n' >&2
                        exit 2
                    }
                    compose exec -T gateway python -m gateway set-setup-choice companion:accept
                    ;;
                model)
                    [ "$#" -eq 1 ] || {
                        printf 'First run conker setup models, then use conker setup run model CANDIDATE_ID.\n' >&2
                        exit 2
                    }
                    compose exec -T gateway python -m gateway set-setup-model "$1"
                    ;;
                protection)
                    cmd_setup verify-protection "$@"
                    ;;
                rehearsal)
                    case "${1:-}" in
                        --review-memory) [ "$#" -eq 1 ] || exit 2; compose exec -T gateway python -m gateway setup-rehearsal review-memory ;;
                        --start-approval) [ "$#" -eq 1 ] || exit 2; compose exec -T gateway python -m gateway setup-rehearsal start-approval ;;
                        --finish-approval) [ "$#" -eq 2 ] || { printf 'Use --finish-approval REQUEST_ID.\n' >&2; exit 2; }; compose exec -T gateway python -m gateway setup-rehearsal "resume-approval:$2" ;;
                        --finalize) [ "$#" -eq 1 ] || exit 2; compose exec -T gateway python -m gateway setup-rehearsal finalize ;;
                        *) printf 'Use conker setup run rehearsal --review-memory|--start-approval|--finish-approval REQUEST_ID|--finalize.\n' >&2; exit 2 ;;
                    esac
                    ;;
                *)
                    printf 'Headless setup run supports companion, model, memory, capabilities, boundaries, protection and rehearsal. Use conker setup status for the next verified operation.\n' >&2
                    exit 2
                    ;;
            esac
            ;;
        *)
            printf 'Use conker setup status|models|protection|rehearsal, conker setup configure protection, or conker setup run STEP.\n' >&2
            exit 2
            ;;
    esac
}

provider_directory() {
    case "$LAYOUT" in
        repository) printf '%s' "$ROOT/.conker/provider-secrets" ;;
        ubuntu) printf '%s' "$ROOT/state/provider-secrets" ;;
    esac
}

provider_call() {
    python3 "$SOURCE_ROOT/scripts/provider_secrets.py" \
        --directory "$(provider_directory)" "$@"
}

provider_runtime_configured() {
    local provider=$1 expected=${2:-configured} _attempt result
    for _attempt in $(seq 1 30); do
        result=$(compose exec -T pi python -c '
import json, sys, urllib.request
provider = sys.argv[1]
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
try:
    with opener.open("http://127.0.0.1:8050/health", timeout=3) as response:
        body = response.read(262145)
    if len(body) > 262144:
        raise ValueError()
    configured = json.loads(body)["checks"]["provider_credentials"]["configured"]
    print("configured" if provider in configured else "missing")
except Exception:
    print("unavailable")
' "$provider" 2>/dev/null || true)
        [ "$result" = "$expected" ] && return 0
        sleep 1
    done
    return 1
}

provider_restart_runtime() {
    compose up -d --no-deps --force-recreate pi || return 1
    local services
    services=$(compose config --services) || return 1
    if printf '%s\n' "$services" | grep -qx decisions; then
        compose up -d --no-deps --force-recreate decisions || return 1
    fi
}

provider_restore_runtime() {
    local provider=$1 revision=$2 expected
    expected=$(provider_call status | python3 -c 'import json,sys; row=next(item for item in json.load(sys.stdin)["providers"] if item["id"] == sys.argv[1]); print("configured" if row["configured"] else "missing")' "$provider") || return 1
    provider_call rollback "$provider" "$revision" --hold >/dev/null || return 1
    provider_restart_runtime && provider_runtime_configured "$provider" "$expected" || return 1
    provider_call complete-rollback "$provider" "$revision" >/dev/null
}

provider_status_human() {
    provider_call status | python3 -c '
import json, sys
value = json.load(sys.stdin)
print("\nHosted providers\n")
for item in value["providers"]:
    active = item["activeRevision"] or "not configured"
    staged = item["stagedRevision"] or "none"
    verification = item["verificationStatus"] or "none"
    if item["verificationStale"]:
        verification += ", stale"
    pending = "; activation recovery required" if item["activationPending"] else ""
    print(f"  {item['"'"'id'"'"']:<11} active: {active}")
    print(f"              staged: {staged} ({verification}){pending}")
print("\n  Secret values are not included.\n")
'
}

cmd_providers() {
    command -v python3 >/dev/null 2>&1 || {
        printf 'Python 3.11+ is required for provider credential management.\n' >&2
        exit 1
    }
    require_installation
    local action=${1:-status}
    shift || true
    case "$action" in
        chatgpt)
            PYTHONPATH="$SOURCE_ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m scripts.chatgpt_cli --root "$ROOT" --layout "$LAYOUT" "$@"
            ;;
        install-ui-control)
            [ "$#" -eq 0 ] || { printf 'Use conker providers install-ui-control.\n' >&2; exit 2; }
            python3 "$SOURCE_ROOT/scripts/provider_control_install.py" --root "$ROOT" --source "$SOURCE_ROOT" --layout "$LAYOUT"
            ;;
        spending)
            [ "$#" -eq 1 ] || { printf 'Use conker providers spending status|on|off|recover.\n' >&2; exit 2; }
            PYTHONPATH="$SOURCE_ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m scripts.provider_paid_policy --root "$ROOT" --layout "$LAYOUT" "$1"
            ;;
        status)
            if [ "${1:-}" = --json ] && [ "$#" -eq 1 ]; then
                provider_call status
            elif [ "$#" -eq 0 ]; then
                provider_status_human
            else
                printf 'Use conker providers status [--json].\n' >&2; exit 2
            fi
            ;;
        set)
            recovery_guard
            local provider=${1:-} secret=''
            [ -n "$provider" ] || { printf 'Use conker providers set PROVIDER [--stdin].\n' >&2; exit 2; }
            if [ "${2:-}" = --stdin ] && [ "$#" -eq 2 ]; then
                provider_call stage "$provider"
            elif [ "$#" -eq 1 ] && [ -t 0 ]; then
                printf 'Provider key (input hidden): '
                read -r -s secret || secret=''
                printf '\n'
                printf '%s' "$secret" | provider_call stage "$provider"
                unset secret
            else
                printf 'Use an interactive terminal or pipe the key to conker providers set PROVIDER --stdin.\n' >&2
                exit 2
            fi
            ;;
        verify)
            recovery_guard
            [ "$#" -eq 1 ] || { printf 'Use conker providers verify PROVIDER.\n' >&2; exit 2; }
            local verified
            verified=$(provider_call verify "$1")
            printf '%s\n' "$verified"
            printf '%s' "$verified" | python3 -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin)["verificationStatus"] == "verified" else 1)'
            ;;
        discard)
            recovery_guard
            [ "$#" -eq 2 ] || { printf 'Use conker providers discard PROVIDER REVISION.\n' >&2; exit 2; }
            provider_call discard "$1" "$2"
            ;;
        activate)
            recovery_guard
            [ "$#" -eq 2 ] || { printf 'Use conker providers activate PROVIDER REVISION.\n' >&2; exit 2; }
            local activate_provider=$1 activate_revision=$2
            provider_call prepare "$activate_provider" "$activate_revision" >/dev/null
            if provider_restart_runtime \
                    && provider_runtime_configured "$activate_provider"; then
                provider_call commit "$activate_provider" "$activate_revision"
                good "$activate_provider credential $activate_revision is active"
            else
                warn "Pi did not confirm the staged provider; restoring the previous credential"
                if provider_restore_runtime "$activate_provider" "$activate_revision"; then
                    printf 'Provider activation failed; the previous credential and runtime were restored.\n' >&2
                else
                    printf 'Provider activation recovery is pending. Inspect status and use providers recover before changing keys.\n' >&2
                fi
                exit 1
            fi
            ;;
        recover)
            recovery_guard
            [ "$#" -eq 2 ] || { printf 'Use conker providers recover PROVIDER REVISION.\n' >&2; exit 2; }
            provider_restore_runtime "$1" "$2"
            good "Restored the credential that preceded $2"
            ;;
        record-revoked)
            recovery_guard
            [ "$#" -eq 3 ] && [ "$3" = --issuer-confirmed ] || {
                printf 'Use conker providers record-revoked PROVIDER REVISION --issuer-confirmed.\n' >&2
                exit 2
            }
            provider_call record-revoked "$1" "$2"
            ;;
        *)
            printf 'Use conker providers status, set, verify, discard, activate, recover, record-revoked, spending, or install-ui-control.\n' >&2
            exit 2
            ;;
    esac
}

