new file mode 100644
index 0000000..1952dec
--- /dev/null
+++ b/pi/search_excerpt.py
@@ -0,0 +1,15 @@
+"""Bounded literal-match previews retain offsets in the original Unicode text."""
+
+
+def excerpt(text, query, *, width=400, leading=80):
+    folded_position = text.casefold().find(query.casefold())
+    position = max(0, folded_position)
+    if folded_position > 0 and not text.isascii():
+        folded_offset = 0
+        for index, character in enumerate(text):
+            folded_offset += len(character.casefold())
+            if folded_offset > folded_position:
+                position = index
+                break
+    start = max(0, position - leading)
+    return text[start : start + width]
diff --git a/pi/session_history.py b/pi/session_history.py
new file mode 100644
index 0000000..d0c38f7
--- /dev/null
+++ b/pi/session_history.py
@@ -0,0 +1,176 @@
+"""Compact owner-readable chat directory; distinct from cross-source search.
+
+Private chats remain readable by their owner, as on the existing session list.
+This reads session metadata only, never transcripts, memory, or a model. Pages
+are individual snapshots, not a claim that an earlier page is still current.
+"""
+
+import hashlib
+import json
+import math
+import re
+
+from .tasks import TaskError
+
+MAX_QUERY = 200
+MAX_CURSOR = 196
+MAX_TITLE = 300
+MAX_PREVIEW = 400
+MAX_PAGE_BYTES = 256 * 1024
+_ID = re.compile(r"[A-Za-z0-9_-]{1,128}", re.ASCII)
+_CURSOR = re.compile(r"h1\.([0-9a-f]{64})\.([A-Za-z0-9_-]{1,128})", re.ASCII)
+_FORGOTTEN = "(s.status='forgotten' OR f.session_id IS NOT NULL)"
+
+
+def _invalid_request():
+    raise TaskError("invalid_history_request", "Use a bounded history query and page size.", 422)
+
+
+def _invalid_cursor():
+    raise TaskError(
+        "invalid_history_cursor", "History cursor unavailable; restart this search.", 422
+    )
+
+
+def _unavailable():
+    raise TaskError("history_unavailable", "Conversation history is unavailable.", 503)
+
+
+def request_arguments(params):
+    """Validate the whole query, including unknown or repeated fields."""
+    if set(params) - {"q", "limit", "cursor"} or any(
+        len(params.getlist(key)) != 1 for key in params
+    ):
+        _invalid_request()
+    raw_limit = params.get("limit", "50")
+    if not re.fullmatch(r"[0-9]{1,2}", raw_limit, re.ASCII):
+        _invalid_request()
+    return {"limit": int(raw_limit), "q": params.get("q"), "cursor": params.get("cursor")}
+
+
+def _arguments(limit, q, cursor):
+    if type(limit) is not int or not 1 <= limit <= 50:
+        _invalid_request()
+    if q is not None and (not isinstance(q, str) or len(q) > MAX_QUERY or "\x00" in q):
+        _invalid_request()
+    try:
+        normalized = (q or "").strip().casefold()
+        digest = hashlib.sha256(normalized.encode("utf-8")).hexdigest()
+    except UnicodeError:
+        _invalid_request()
+    anchor = None
+    if cursor is not None:
+        if not isinstance(cursor, str) or len(cursor) > MAX_CURSOR:
+            _invalid_cursor()
+        match = _CURSOR.fullmatch(cursor)
+        if match is None or match[1] != digest:
+            _invalid_cursor()
+        anchor = match[2]
+    return normalized, digest, anchor
+
+
+def _text(value, maximum):
+    return value[:maximum] if isinstance(value, str) else None
+
+
+def _time(value, nullable=False):
+    if value is None and nullable:
+        return None
+    if (
+        type(value) not in (int, float)
+        or not math.isfinite(value)
+        or not 0 <= value <= 8_640_000_000_000
+    ):
+        _unavailable()
+    return value
+
+
+def _record(row):
+    if (
+        not isinstance(row["id"], str)
+        or not _ID.fullmatch(row["id"])
+        or (
+            row["parent_id"] is not None
+            and (not isinstance(row["parent_id"], str) or not _ID.fullmatch(row["parent_id"]))
+        )
+    ):
+        _unavailable()
+    if row["status"] not in {"open", "forked", "closed", "forgotten"} or not isinstance(
+        row["title"], str
+    ):
+        _unavailable()
+    return {
+        "id": row["id"],
+        "parent_id": row["parent_id"],
+        "title": row["title"],
+        "status": row["status"],
+        "created_at": _time(row["created_at"]),
+        "closed_at": _time(row["closed_at"], nullable=True),
+        "summary_preview": row["summary_preview"],
+        "title_truncated": bool(row["title_truncated"]),
+        "summary_truncated": bool(row["summary_truncated"]),
+        "content_status": "forgotten" if row["status"] == "forgotten" else "available",
+    }
+
+
+def page(store, *, limit=50, q=None, cursor=None):
+    normalized, digest, anchor = _arguments(limit, q, cursor)
+    with store._connect() as db:
+        db.execute("BEGIN")
+        # Python casefold handles Unicode; SQLite LOWER/NOCASE handles only ASCII.
+        db.create_function(
+            "history_casefold",
+            1,
+            lambda value: value.casefold() if isinstance(value, str) else "",
+            deterministic=True,
+        )
+        # Unlike SQLite substr/length, these also preserve embedded NUL in old metadata.
+        db.create_function("history_preview", 2, _text, deterministic=True)
+        db.create_function(
+            "history_length",
+            1,
+            lambda value: len(value) if isinstance(value, str) else 0,
+            deterministic=True,
+        )
+        where, values = [], []
+        if normalized:
+            where.append(f"NOT {_FORGOTTEN}")
+            # instr is a literal substring operation: %, _ and backslash are not patterns.
+            where.append(
+                "(instr(history_casefold(s.title),?)>0 OR instr(history_casefold(s.summary),?)>0)"
+            )
+            values.extend((normalized, normalized))
+        if anchor is not None:
+            boundary = db.execute(
+                "SELECT created_at,id FROM sessions WHERE id=?", (anchor,)
+            ).fetchone()
+            if boundary is None:
+                _invalid_cursor()
+            _time(boundary["created_at"])
+            where.append("(s.created_at,s.id)<(?,?)")
+            values.extend((boundary["created_at"], boundary["id"]))
+        clause = " WHERE " + " AND ".join(where) if where else ""
+        rows = db.execute(
+            f"SELECT s.id,s.parent_id,s.created_at,s.closed_at,"
+            f"CASE WHEN {_FORGOTTEN} THEN 'forgotten' ELSE s.status END AS status,"
+            f"CASE WHEN {_FORGOTTEN} THEN '' ELSE history_preview(s.title,{MAX_TITLE}) END AS title,"
+            f"CASE WHEN {_FORGOTTEN} THEN NULL ELSE history_preview(s.summary,{MAX_PREVIEW}) END AS summary_preview,"
+            f"CASE WHEN {_FORGOTTEN} THEN 0 ELSE history_length(s.title)>{MAX_TITLE} END AS title_truncated,"
+            f"CASE WHEN {_FORGOTTEN} THEN 0 ELSE history_length(s.summary)>{MAX_PREVIEW} END AS summary_truncated "
+            "FROM sessions s LEFT JOIN forgotten_sessions f ON f.session_id=s.id"
+            + clause
+            + " ORDER BY s.created_at DESC,s.id DESC LIMIT ?",
+            (*values, limit + 1),
+        ).fetchall()
+        results = [_record(row) for row in rows[:limit]]
+        result = {
+            "schemaVersion": 1,
+            "results": results,
+            "next_cursor": f"h1.{digest}.{results[-1]['id']}" if len(rows) > limit else None,
+        }
+        if (
+            len(json.dumps(result, ensure_ascii=False, allow_nan=False).encode("utf-8"))
+            > MAX_PAGE_BYTES
+        ):
+            _unavailable()
+        return result
diff --git a/pi/session_observation.py b/pi/session_observation.py
new file mode 100644
index 0000000..f6240d1
--- /dev/null
+++ b/pi/session_observation.py
@@ -0,0 +1,136 @@
+"""Content-free change tokens for observing work started by another client.
+
+Counters change in the transaction that changes history, not when a browser
+reads them. Read this token before loading history: a later token must never be
+used to acknowledge an earlier, possibly nontransactional history projection.
+"""
+
+MAX_SAFE_REVISION = (1 << 53) - 1
+
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS session_observations (
+ session_id TEXT PRIMARY KEY REFERENCES sessions(id),
+ revision INTEGER NOT NULL CHECK(typeof(revision)='integer' AND revision>=0)
+);
+INSERT OR IGNORE INTO session_observations SELECT id,0 FROM sessions;
+CREATE INDEX IF NOT EXISTS observation_running_turns ON turns(session_id) WHERE status='running';
+CREATE INDEX IF NOT EXISTS observation_active_thinking ON background_thinking(session_id)
+ WHERE status IN ('queued','running');
+CREATE TRIGGER IF NOT EXISTS session_observation_session_insert AFTER INSERT ON sessions
+BEGIN
+ INSERT INTO session_observations VALUES(NEW.id,1)
+ ON CONFLICT(session_id) DO UPDATE SET revision=revision+1;
+END;
+"""
+
+
+def _trigger(table, operation, identities):
+    # Identifiers/expressions below are fixed schema definitions, never request input.
+    return f"""
+CREATE TRIGGER IF NOT EXISTS session_observation_{table}_{operation.lower()}
+AFTER {operation} ON {table}
+BEGIN
+ UPDATE session_observations SET revision=revision+1
+ WHERE session_id IN ({identities});
+END;
+"""
+
+
+SCHEMA += _trigger("sessions", "UPDATE", "SELECT OLD.id UNION SELECT NEW.id")
+for _table in ("messages", "background_thinking", "forgotten_sessions", "response_families"):
+    for _operation in ("INSERT", "UPDATE", "DELETE"):
+        _rows = (
+            ("NEW",)
+            if _operation == "INSERT"
+            else ("OLD",)
+            if _operation == "DELETE"
+            else ("OLD", "NEW")
+        )
+        SCHEMA += _trigger(
+            _table, _operation, " UNION ".join(f"SELECT {row}.session_id" for row in _rows)
+        )
+for _operation in ("INSERT", "UPDATE", "DELETE"):
+    _rows = (
+        ("NEW",)
+        if _operation == "INSERT"
+        else ("OLD",)
+        if _operation == "DELETE"
+        else ("OLD", "NEW")
+    )
+    SCHEMA += _trigger(
+        "turns",
+        _operation,
+        " UNION ".join(f"SELECT {row}.session_id" for row in _rows)
+        + " UNION SELECT requested_session_id FROM turn_submissions WHERE turn_id IN ("
+        + ",".join(f"{row}.id" for row in _rows)
+        + ")",
+    )
+    SCHEMA += _trigger(
+        "turn_submissions",
+        _operation,
+        " UNION ".join(
+            f"SELECT {row}.{column}"
+            for row in _rows
+            for column in ("requested_session_id", "effective_session_id")
+        ),
+    )
+    SCHEMA += _trigger(
+        "tool_actions",
+        _operation,
+        "SELECT session_id FROM turns WHERE id IN ("
+        + ",".join(f"{row}.turn_id" for row in _rows)
+        + ")",
+    )
+    SCHEMA += _trigger(
+        "response_versions",
+        _operation,
+        "SELECT session_id FROM messages WHERE id IN ("
+        + ",".join(f"{row}.message_id" for row in _rows)
+        + ")",
+    )
+
+
+def initialize(db):
+    # Run after the observed tables exist; backfill never resets existing counters.
+    db.executescript(SCHEMA)
+
+
+def read(store, session_id):
+    with store._connect() as db:
+        db.execute("BEGIN")
+        row = db.execute(
+            "SELECT s.status,o.revision,EXISTS(SELECT 1 FROM forgotten_sessions f "
+            "WHERE f.session_id=s.id) AS forgotten FROM sessions s "
+            "JOIN session_observations o ON o.session_id=s.id WHERE s.id=?",
+            (session_id,),
+        ).fetchone()
+        if row is None:
+            raise ValueError("Conversation not found.")
+        revision = row["revision"]
+        # Do not round, wrap or saturate a counter into a misleading unchanged token.
+        if type(revision) is not int or not 0 <= revision <= MAX_SAFE_REVISION:
+            raise OverflowError("Conversation observation unavailable.")
+        forgotten = bool(row["forgotten"] or row["status"] == "forgotten")
+        active = (
+            False
+            if forgotten
+            else bool(
+                db.execute(
+                    "SELECT EXISTS(SELECT 1 FROM turns WHERE session_id=? AND status='running') "
+                    "OR EXISTS(SELECT 1 FROM turns t JOIN turn_submissions s ON s.turn_id=t.id "
+                    "WHERE s.requested_session_id=? AND t.status='running') "
+                    "OR EXISTS(SELECT 1 FROM turn_submissions "
+                    "WHERE (requested_session_id=? OR effective_session_id=?) AND state='preparing') "
+                    "OR EXISTS(SELECT 1 FROM background_thinking "
+                    "WHERE session_id=? AND status IN ('queued','running'))",
+                    (session_id, session_id, session_id, session_id, session_id),
+                ).fetchone()[0]
+            )
+        )
+        return {
+            "schemaVersion": 1,
+            "session_id": session_id,
+            "revision": revision,
+            "active": active,
+            "content_status": "forgotten" if forgotten else "available",
+        }
diff --git a/pi/session_settings.py b/pi/session_settings.py
index 07ab799..7c60763 100644
--- a/pi/session_settings.py
+++ b/pi/session_settings.py
@@ -64,6 +64,78 @@ for _table, _id in (
     SCHEMA += f"CREATE TRIGGER IF NOT EXISTS {_table}_no_replace BEFORE INSERT ON {_table} WHEN EXISTS(SELECT 1 FROM {_table} WHERE {_id}=NEW.{_id}) BEGIN SELECT RAISE(ABORT,'execution selection is immutable'); END;\n"
 
 
+MAX_PRIVACY_LINEAGE = 256
+
+
+def inherited_privacy(db, identity):
+    """Retain carried exclusions through summaries, never ancestors' own-history policy.
