+def receipt(item, *, state="admitted", method="owner_requested", agent="default", stamp=True):
+    rid = str(uuid5(NAMESPACE_URL, f"pi:{agent}:{item['id']}"))
+    result = {
+        "id": rid,
+        "message_id": item["id"],
+        "state": state,
