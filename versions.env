# Pinned image versions. The single place any of them is written down.
#
# Never `latest`, for anything an owner runs. A moving tag is a supply chain
# attack that needs no attacker — see docs/adr/0008-supply-chain-policy.md.
#
# Our own modules are pinned by version tag: we control those repositories and
# the tag is the release. Third-party images are pinned by **digest**, because
# an upstream tag is theirs to move and ours to be surprised by. The version
# beside each digest is what that digest actually is, so upgrading is a legible
# diff rather than an opaque hash swap.

# --- release identity -------------------------------------------------------
# CONKER_VERSION=X.Y.Z is set by a release PR, together with a `## X.Y.Z` section in
# CHANGELOG.md; the tag vX.Y.Z then publishes the release page (.github/workflows/release.yml).
# A tree without it is an unreleased build: `conker update --check` offers any release.
# Increment when the shape or interpretation of this file changes.
RELEASE_MANIFEST_VERSION=2
# Exact Git tree object for dashboard/. Unlike a commit SHA, this remains exact
# without becoming self-referential when release tooling beside the UI changes.
CONKER_DASHBOARD_REVISION=dd0c8c73a6fd5c39a08d3f46a324bf49530a9f59

# Written WITHOUT the leading `v`. The git tag is `v0.2.2`; the image tag the
# publish workflow produces from it is `0.2.2`, because docker/metadata-action
# strips the prefix. Pinning `v0.2.2` here resolves to nothing at all, and the
# error arrives as a 404 during `docker compose pull` - a long way from this
# file. A test asserts every reference below actually exists in the registry.

# --- Conker's own modules ---------------------------------------------------
PI_VERSION=0.24.0
TOOLGATE_VERSION=0.15.1
MEMORYGATE_VERSION=0.8.2
SYSTEMGATE_VERSION=0.5.2
EMBEDDINGS_VERSION=0.1.7

# Optional capabilities are explicit. Promoting the owner terminal requires a
# digest-pinned registry image and the digest of its target-Linux acceptance bundle.
OWNER_TERMINAL_STATE=deferred
# The agent sandbox (ADR-0013): agents' Terminal and Install packages tools. Needs ToolGate 0.6.0
# or newer (the sandbox runner) and the sandbox image published with that release, by digest.
AGENT_SANDBOX_STATE=active
AGENT_SANDBOX_IMAGE=ghcr.io/conker-ai/toolgate-sandbox@sha256:c4fcf6a88749c2fad3e10a144a9ea1c785b6a2f46ae09139a6f2d6dd358b7ff7
# The Claude plan runtime (services/subscriptions, docker-compose.subscriptions.yml), which an owner
# turns on with ./install.sh --claude-plan. It becomes active with the image the publish workflow
# prints for a subscriptions-vX.Y.Z tag, by digest:
# SUBSCRIPTIONS_IMAGE=ghcr.io/conker-ai/subscriptions@sha256:<digest>. See
# docs/reference/claude-plan-runtime.md.
SUBSCRIPTIONS_STATE=deferred
# Direct API keys for Gemini, xAI, Mistral, DeepSeek and Groq (docker-compose.direct-providers.yml).
# Needs a Pi that reads them (0.17.0 or later, pi#152); deferred lists OpenRouter, OpenAI and
# Anthropic only.
DIRECT_PROVIDERS_STATE=active

# --- third party ------------------------------------------------------------
# PostgreSQL 16.15
POSTGRES_IMAGE=postgres@sha256:9e2cf6287f25c3151f4c9421ccce2b17f3e60061c111a29165e0d2cdd9ff0a97
# Qdrant 1.19.2
QDRANT_IMAGE=qdrant/qdrant@sha256:b7b0444c4c351c970b98e90a6f89c2ee4287c65b44e52b4cb503fa5b2aa927ad
# Ollama 0.40.6
OLLAMA_IMAGE=ollama/ollama@sha256:265409e1d931028a8f7d5a32bcbafddd7bffbc6cc629d77efe9560adf692a5e7
# SearXNG, as pinned by ToolGate's own compose
SEARXNG_IMAGE=searxng/searxng@sha256:5ed0323b5f5f8701264ef65e239a2bd83cb57098f2b971fa30bf79c06eeae271
# Node 22.20.0, used only as the reproducible dashboard build environment.
NODE_BUILD_IMAGE=node@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e
