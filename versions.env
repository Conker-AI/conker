# Pinned image versions. The single place any of them is written down.
#
# Never `latest`, for anything an owner runs. A moving tag is a supply chain
# attack that needs no attacker — see docs/adr/0008-supply-chain-policy.md.
#
# Our own modules are pinned by version tag: we control those repositories and
# the tag is the release. Third-party images are pinned by **digest**, because
# an upstream tag is theirs to move and ours to be surprised by. The version
# beside each digest is what that digest actually is, so upgrading is a legible
# diff rather than an opaque hash swap.

# --- release identity -------------------------------------------------------
# Increment when the shape or interpretation of this file changes.
RELEASE_MANIFEST_VERSION=2
# Exact Git tree object for dashboard/. Unlike a commit SHA, this remains exact
# without becoming self-referential when release tooling beside the UI changes.
CONKER_DASHBOARD_REVISION=391a8fad5b7e2930a3308a2b2897da111c276add

# Written WITHOUT the leading `v`. The git tag is `v0.2.2`; the image tag the
# publish workflow produces from it is `0.2.2`, because docker/metadata-action
# strips the prefix. Pinning `v0.2.2` here resolves to nothing at all, and the
# error arrives as a 404 during `docker compose pull` - a long way from this
# file. A test asserts every reference below actually exists in the registry.

# --- Conker's own modules ---------------------------------------------------
PI_VERSION=0.5.4
TOOLGATE_VERSION=0.4.0
MEMORYGATE_VERSION=0.4.1
SYSTEMGATE_VERSION=0.3.0
EMBEDDINGS_VERSION=0.1.3

# Optional capabilities are explicit. Promoting the owner terminal requires a
# digest-pinned registry image and the digest of its target-Linux acceptance bundle.
OWNER_TERMINAL_STATE=deferred

# --- third party ------------------------------------------------------------
# PostgreSQL 16.14
POSTGRES_IMAGE=postgres@sha256:17e67d7b9890c99b055ba1e0d5c5be4ec27c9d3a72bda32db24a5e5d8a85af0c
# Qdrant 1.18.2
QDRANT_IMAGE=qdrant/qdrant@sha256:75eab8c4ba42096724fdcfde8b4de0b5713d529dde32f285a1f86fdcb2c9e50c
# Ollama 0.32.3
OLLAMA_IMAGE=ollama/ollama@sha256:ec24bcaa2a810eb74171ce7c517813ef4821ed678988845e8d76cf62467036d4
# SearXNG, as pinned by ToolGate's own compose
SEARXNG_IMAGE=searxng/searxng@sha256:b8ca38ba06eea544d7555e88321e212ddc0d5c3c7de055419cfb2e5c6bf30812
# Node 22.20.0, used only as the reproducible dashboard build environment.
NODE_BUILD_IMAGE=node@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e
