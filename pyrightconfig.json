{
  "typeCheckingMode": "basic",
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "include": [
    "scripts",
    "tests"
  ],
  "extraPaths": [
    "scripts"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "dashboard",
    "services"
  ],
  "reportMissingImports": "warning"
}
