# Secrets. Every value in here is a key; the installer writes it at 0600.
.env
.env.local
*.tmp.*

# Where the owner's data lands if they accept the defaults.
/conker-backups/
/data/

# Recovery state contains credentials or identifiers for owner data.
.conker-backup.lock
.conker-recovery.json
.test-gates/
.local-run/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Editors and platforms
.DS_Store
Thumbs.db
.idea/
*.swp

# Agent skills installed by `skills add` — symlinked into .claude/ per client.
# The skill sources are committed; the per-client symlinks are not.
.claude/skills/
