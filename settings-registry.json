{
  "schemaVersion": 1,
  "settings": [
    {
      "id": "notifications.quiet_hours.enabled",
      "title": "Quiet hours",
      "description": "During these hours the Companion starts no suggestions or research of its own.",
      "scope": "global",
      "tier": "basic",
      "type": "toggle",
      "default": true,
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "quietHours.enabled"
      },
      "effect": "live",
      "keywords": [
        "night",
        "sleep",
        "do not disturb"
      ],
      "related": [
        "notifications.quiet_hours.start",
        "notifications.quiet_hours.end",
        "notifications.quiet_hours.time_zone"
      ]
    },
    {
      "id": "notifications.quiet_hours.start",
      "title": "Quiet hours start",
      "description": "When quiet hours begin, in 24-hour time.",
      "scope": "global",
      "tier": "basic",
      "type": "time",
      "default": "22:00",
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "quietHours.start"
      },
      "effect": "live",
      "keywords": [],
      "related": [],
      "dependsOn": {
        "id": "notifications.quiet_hours.enabled",
        "value": true
      }
    },
    {
      "id": "notifications.quiet_hours.end",
      "title": "Quiet hours end",
      "description": "When quiet hours end, in 24-hour time; must differ from the start.",
      "scope": "global",
      "tier": "basic",
      "type": "time",
      "default": "07:00",
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "quietHours.end"
      },
      "effect": "live",
      "keywords": [],
      "related": [],
      "dependsOn": {
        "id": "notifications.quiet_hours.enabled",
        "value": true
      }
    },
    {
      "id": "notifications.quiet_hours.time_zone",
      "title": "Time zone",
      "description": "The time zone quiet hours and daily budgets follow.",
      "scope": "global",
      "tier": "basic",
      "type": "timezone",
      "default": "Asia/Jerusalem",
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "quietHours.timeZone"
      },
      "effect": "live",
      "keywords": [
        "timezone",
        "clock"
      ],
      "related": []
    },
    {
      "id": "notifications.quiet_hours.urgent_exceptions",
      "title": "Urgent messages during quiet hours",
      "description": "Let urgent messages through quiet hours.",
      "scope": "global",
      "tier": "advanced",
      "type": "toggle",
      "default": false,
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "quietHours.urgentExceptions"
      },
      "effect": "live",
      "keywords": [],
      "related": [],
      "dependsOn": {
        "id": "notifications.quiet_hours.enabled",
        "value": true
      }
    },
    {
      "id": "companion.proactivity",
      "title": "When the Companion reaches out",
      "description": "Meaningful updates, only urgent ones, or never.",
      "scope": "global",
      "tier": "basic",
      "type": "select",
      "default": "meaningful",
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "urgency"
      },
      "effect": "live",
      "keywords": [
        "proactive",
        "notifications",
        "suggestions"
      ],
      "related": [
        "companion.daily_budget.suggestions"
      ],
      "options": [
        "meaningful",
        "urgent_only",
        "off"
      ]
    },
    {
      "id": "companion.daily_budget.suggestions",
      "title": "Suggestions per day",
      "description": "How many suggestions the Companion may make each day.",
      "scope": "global",
      "tier": "advanced",
      "type": "number",
      "default": 4,
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "dailyBudget.suggestions"
      },
      "effect": "live",
      "keywords": [
        "limit"
      ],
      "related": [],
      "min": 0,
      "max": 100
    },
    {
      "id": "companion.daily_budget.research_minutes",
      "title": "Research minutes per day",
      "description": "How long the Companion may research on its own each day.",
      "scope": "global",
      "tier": "advanced",
      "type": "number",
      "default": 30,
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "dailyBudget.researchMinutes"
      },
      "effect": "live",
      "keywords": [
        "limit"
      ],
      "related": [],
      "min": 0,
      "max": 1440
    },
    {
      "id": "companion.daily_budget.cost_cents",
      "title": "Spending per day",
      "description": "How much, in cents, the Companion may spend on its own each day.",
      "scope": "global",
      "tier": "advanced",
      "type": "number",
      "default": 0,
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "dailyBudget.costCents"
      },
      "effect": "live",
      "keywords": [
        "limit",
        "money"
      ],
      "related": [],
      "min": 0,
      "max": 100000
    },
    {
      "id": "session.idle_timeout_minutes",
      "title": "Idle lock",
      "description": "Minutes before Conker locks after inactivity. Saved, but nothing enforces it yet.",
      "scope": "global",
      "tier": "advanced",
      "type": "select",
      "default": 15,
      "home": {
        "service": "pi",
        "path": "/owner/preferences",
        "key": "preferences",
        "field": "idleTimeoutMinutes"
      },
      "effect": "stored",
      "keywords": [],
      "related": [],
      "options": [
        0,
        5,
        15,
        30,
        60
      ]
    },
    {
      "id": "search.sources",
      "title": "Search sources",
      "description": "What global search looks through.",
      "scope": "global",
      "tier": "basic",
      "type": "list",
      "default": [
        "conversations",
        "memory",
        "projects",
        "artifacts",
        "tasks",
        "jobs",
        "agents",
        "tools",
        "activity"
      ],
      "home": {
        "service": "pi",
        "path": "/search/settings",
        "key": "configuration",
        "field": "sources"
      },
      "effect": "live",
      "keywords": [
        "find"
      ],
      "related": [],
      "options": [
        "conversations",
        "memory",
        "projects",
        "artifacts",
        "tasks",
        "jobs",
        "agents",
        "tools",
        "activity"
      ]
    },
    {
      "id": "search.exact_text",
      "title": "Exact text search",
      "description": "Match the words you type literally.",
      "scope": "global",
      "tier": "basic",
      "type": "toggle",
      "default": true,
      "home": {
        "service": "pi",
        "path": "/search/settings",
        "key": "configuration",
        "field": "exactText"
      },
      "effect": "live",
      "keywords": [],
      "related": []
    },
    {
      "id": "search.semantic",
      "title": "Meaning search",
      "description": "Also find results by meaning. Needs the embeddings service.",
      "scope": "global",
      "tier": "advanced",
      "type": "toggle",
      "default": false,
      "home": {
        "service": "pi",
        "path": "/search/settings",
        "key": "configuration",
        "field": "semantic"
      },
      "effect": "live",
      "keywords": [
        "semantic",
        "embeddings"
      ],
      "related": []
    },
    {
      "id": "search.reranking",
      "title": "AI ranking",
      "description": "Let a model reorder results. Needs a search ranking model.",
      "scope": "global",
      "tier": "advanced",
      "type": "toggle",
      "default": false,
      "home": {
        "service": "pi",
        "path": "/search/settings",
        "key": "configuration",
        "field": "reranking"
      },
      "effect": "live",
      "keywords": [
        "rank",
        "model"
      ],
      "related": []
    },
    {
      "id": "chat.agent",
      "title": "Agent",
      "description": "Which agent answers in this chat (companion or an agent id).",
      "scope": "chat",
      "tier": "basic",
      "type": "text",
      "default": "companion",
      "home": {
        "service": "pi",
        "path": "/sessions/{chat}/settings",
        "key": "settings",
        "field": "agentId"
      },
      "effect": "next-turn",
      "keywords": [],
      "related": [],
      "pattern": "^(companion|agent_[0-9a-f]{32})$"
    },
    {
      "id": "chat.privacy.memory_off",
      "title": "Memory off",
      "description": "This chat neither reads nor adds long-term memory.",
      "scope": "chat",
      "tier": "basic",
      "type": "toggle",
      "default": false,
      "home": {
        "service": "pi",
        "path": "/sessions/{chat}/settings",
        "key": "settings",
        "field": "privacy.memoryDisabled"
      },
      "effect": "next-turn",
      "keywords": [
        "private",
        "privacy"
      ],
      "related": []
    },
    {
      "id": "chat.privacy.tools_off",
      "title": "Tools off",
      "description": "The assistant may not use tools in this chat.",
      "scope": "chat",
      "tier": "basic",
      "type": "toggle",
      "default": false,
      "home": {
        "service": "pi",
        "path": "/sessions/{chat}/settings",
        "key": "settings",
        "field": "privacy.harnessDisabled"
      },
      "effect": "next-turn",
      "keywords": [
        "private",
        "harness"
      ],
      "related": []
    },
    {
      "id": "chat.output.format",
      "title": "Answer format",
      "description": "Let the model choose, or ask for text, a list, a table, a document, code or JSON.",
      "scope": "chat",
      "tier": "basic",
      "type": "select",
      "default": "auto",
      "home": {
        "service": "pi",
        "path": "/sessions/{chat}/output",
        "key": "output",
        "field": "format"
      },
      "effect": "next-turn",
      "keywords": [],
      "related": [],
      "options": [
        "auto",
        "text",
        "list",
        "table",
        "document",
        "code",
        "json"
      ]
    },
    {
      "id": "chat.output.length",
      "title": "Answer length",
      "description": "Let the model choose, or ask for short, medium or long answers.",
      "scope": "chat",
      "tier": "basic",
      "type": "select",
      "default": "auto",
      "home": {
        "service": "pi",
        "path": "/sessions/{chat}/output",
        "key": "output",
        "field": "length"
      },
      "effect": "next-turn",
      "keywords": [],
      "related": [],
      "options": [
        "auto",
        "short",
        "medium",
        "long"
      ]
    },
    {
      "id": "chat.output.language",
      "title": "Answer language",
      "description": "auto, or a language tag such as en, ru or en-GB.",
      "scope": "chat",
      "tier": "basic",
      "type": "text",
      "default": "auto",
      "home": {
        "service": "pi",
        "path": "/sessions/{chat}/output",
        "key": "output",
        "field": "language"
      },
      "effect": "next-turn",
      "keywords": [],
      "related": [],
      "pattern": "^(auto|[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,3})$"
    },
    {
      "id": "chat.context.instructions",
      "title": "Chat instructions",
      "description": "Instructions the model gets for every turn of this chat.",
      "scope": "chat",
      "tier": "basic",
      "type": "text",
      "default": "",
      "home": {
        "service": "pi",
        "path": "/context/{chat}",
        "key": "policy",
        "field": "sessionInstructions"
      },
      "effect": "next-turn",
      "keywords": [
        "system prompt"
      ],
      "related": [],
      "max_length": 16000
    },
    {
      "id": "chat.context.window_tokens",
      "title": "Context window",
      "description": "Tokens the model may receive in total for this chat; larger than the answer reserve plus other input.",
      "scope": "chat",
      "tier": "advanced",
      "type": "number",
      "default": null,
      "home": {
        "service": "pi",
        "path": "/context/{chat}",
        "key": "policy",
        "field": "budget.contextWindowTokens"
      },
      "effect": "next-turn",
      "keywords": [],
      "related": [
        "chat.context.output_reserve_tokens",
        "chat.context.other_input_tokens"
      ],
      "min": 2,
      "max": 10000000
    },
    {
      "id": "chat.context.output_reserve_tokens",
      "title": "Answer reserve",
      "description": "Tokens kept free for the answer.",
      "scope": "chat",
      "tier": "advanced",
      "type": "number",
      "default": null,
      "home": {
        "service": "pi",
        "path": "/context/{chat}",
        "key": "policy",
        "field": "budget.outputReserveTokens"
      },
      "effect": "next-turn",
      "keywords": [],
      "related": [],
      "min": 1
    },
    {
      "id": "chat.context.other_input_tokens",
      "title": "Other input",
      "description": "Tokens set aside for instructions, memory and tools.",
      "scope": "chat",
      "tier": "advanced",
      "type": "number",
      "default": null,
      "home": {
        "service": "pi",
        "path": "/context/{chat}",
        "key": "policy",
        "field": "budget.otherInputTokens"
      },
      "effect": "next-turn",
      "keywords": [],
      "related": [],
      "min": 0
    }
  ]
}
